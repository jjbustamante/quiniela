# Copy this file to terraform.tfvars and fill in. terraform.tfvars is gitignored.

project_id             = "project-99f153c5-0682-4725-abd"
region                 = "us-central1"
owner_email            = "quiniela.panas.svp@gmail.com"
google_oauth_client_id = "760784205999-i5dl0qi25s9rnjpeai8fm0m1i0t8mt9h.apps.googleusercontent.com"

# Workload Identity Federation — pins CI access to this exact GitHub repo.
# Used by iac/workload_identity.tf to build the impersonation principalSet.
github_repository = "jjbustamante/quiniela"

# artifact_registry_repo  = "apps"          # default
# cloud_sql_tier          = "db-f1-micro"   # default; bump for more capacity
# cloud_run_max_instances = 5               # default

# Set AFTER first `tofu apply` — see variables.tf for the explanation.
# Get the value with: tofu output -raw web_service_url
# web_service_url = "https://quiniela-web-XXXXXXXXXX-uc.a.run.app"

# ─── Custom domain (Cloudflare DNS + Cloud Run domain mapping) ──────────────
custom_domain      = "quiniela.dpdns.org"
cloudflare_zone_id = "FILL_ME_IN"       # find on the zone's Overview page in Cloudflare
# cloudflare_api_token is sensitive — better to set via env var instead of
# committing it here. Example:
#   export TF_VAR_cloudflare_api_token="cf_token_..."
# (terraform.tfvars is gitignored, so putting it here is also acceptable for solo use.)

# Copy to .env.local and fill in. .env.local is gitignored.

# Backend URL — used by server components to fetch /actuator/health, /api/*, etc.
# Local dev: http://localhost:8080 (default if unset)
# Production: set on the Cloud Run service via IaC (see iac/cloud_run.tf)
API_URL=http://localhost:8080

# Auth.js v5 / Google OIDC
AUTH_GOOGLE_ID=760784205999-i5dl0qi25s9rnjpeai8fm0m1i0t8mt9h.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=                # paste the client secret (from GCP Console → Credentials)
AUTH_SECRET=                       # `openssl rand -base64 32` — at least 32 chars
# AUTH_TRUST_HOST=true             # set only when running behind a proxy (Cloud Run does this in prod)

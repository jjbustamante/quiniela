# Copy to .env.local and fill in. .env.local is gitignored.

# Backend URL — used by server components to fetch /actuator/health, /api/*, etc.
# Local dev: http://localhost:8080 (default if unset)
# Heroku: set as a config var on quiniela-web pointing at quiniela-api
API_URL=http://localhost:8080

# Google OIDC client credentials (added in PR 4 — auth)
# AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com
# AUTH_GOOGLE_SECRET=your-client-secret
# AUTH_SECRET=                # `openssl rand -base64 32`
# NEXTAUTH_URL=http://localhost:3000

{
  "name": "quiniela-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "overrides": {
      "cross-spawn": "^7.0.5",
      "glob": "^10.5.0",
      "minimatch": "^9.0.7",
      "tar": "^7.5.11"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "msw",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",

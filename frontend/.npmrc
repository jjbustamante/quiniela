# Use hoisted (npm-like) node_modules instead of pnpm's default symlinked
# layout. Required for Next.js 16 + Turbopack inside Heroku CNB builds —
# Turbopack's module resolution walks node_modules looking for next/package.json
# and fails to follow pnpm's symlinks from .pnpm/ correctly, producing:
#
#   Error: Next.js inferred your workspace root, but it may not be correct.
#   We couldn't find the Next.js package (next/package.json) from the
#   project directory: /workspace/app
#
# Tradeoff: ~2-3× larger node_modules and loss of pnpm's strict-deps
# protection. Worth it to keep CNB + Turbopack working.
#
# See brain/plugins/tech/nextjs-cicd/packaging/cnb-nodejs.md.
node-linker=hoisted

# Local dev environment for the Spring Boot backend.
# Copy to backend/.env (gitignored) and fill in. Run via `bin/dev-backend.sh`.

# Google OAuth client ID (the .apps.googleusercontent.com value). The backend
# verifies inbound Google ID tokens have this as the `aud` claim.
AUTH_GOOGLE_ID=760784205999-i5dl0qi25s9rnjpeai8fm0m1i0t8mt9h.apps.googleusercontent.com

# HMAC HS256 key for the session JWTs we issue. Must be at least 32 chars.
# USE THE SAME VALUE as AUTH_SECRET in frontend/.env.local so the backend
# and Auth.js sign with the same key end-to-end.
NEXTAUTH_SECRET=

# Comma-separated emails granted is_admin=true on first sign-in.
ADMIN_EMAILS=bustamantejj@gmail.com

# Database connection (optional — defaults match docker-compose's Postgres).
# Uncomment to override.
# JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/quiniela
# JDBC_DATABASE_USERNAME=quiniela
# JDBC_DATABASE_PASSWORD=dev

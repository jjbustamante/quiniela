<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>io.quiniela</groupId>
    <artifactId>quiniela-api</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>quiniela-api</name>
    <description>Quiniela 2026 backend</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Override Spring Boot's managed versions for security patches that
             haven't yet landed in a SB release. Bump in sync with each SB
             4.0.x release; remove the override when SB catches up. -->
        <tomcat.version>11.0.22</tomcat.version>
        <postgresql.version>42.7.13</postgresql.version>

        <!-- Explicit dep + transitive overrides -->
        <postgres-socket-factory.version>1.29.0</postgres-socket-factory.version>
        <grpc.version>1.83.0</grpc.version>
        <protobuf.version>4.35.1</protobuf.version>
        <google-api-client.version>2.9.0</google-api-client.version>
        <jjwt.version>0.13.0</jjwt.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <wiremock.version>3.13.2</wiremock.version>

        <!-- Build-plugin versions (externalized for visibility + atomic bumps) -->
        <spotless.version>3.8.0</spotless.version>
        <google-java-format.version>1.28.0</google-java-format.version>
        <jacoco.version>0.8.15</jacoco.version>
        <dependency-check.version>12.2.2</dependency-check.version>
        <!-- Spring AI 2.0.x targets Spring Boot 4. M8 is the latest pre-GA
             milestone as of 2026-05-30; swap to GA when released. -->
        <spring-ai.version>2.0.0</spring-ai.version>
        <!-- Google's unified GenAI SDK, used directly by VertexPaulOracle for the
             Vertex AI path (ADC auth, billed to GCP credits). Spring AI's Vertex
             module isn't published on the 2.0.x line, so we call the SDK directly
             behind the PaulOracle seam. Pinned to the version the spring-ai
             google-genai starter already resolves transitively. -->
        <google-genai.version>1.63.0</google-genai.version>
        <!-- Match flyway-core managed by spring-boot-starter-parent. Maven plugin
             scope doesn't inherit dependency-management so we pin explicitly. -->
        <flyway.version>11.20.3</flyway.version>

        <google-cloud-tasks.version>2.94.0</google-cloud-tasks.version>
        <!-- google-cloud-tasks 2.93.0 pulls gax 2.81.0, which needs
             google-auth-library 1.48.0 (the version with
             com.google.auth.mtls.CertificateSourceUnavailableException).
             google-api-client 2.9.0 transitively pins 1.30.0 as the nearest
             dependency, so without this BOM Maven resolves 1.30.0 →
             NoClassDefFoundError at CloudTasksClient.create() (gax
             EndpointContext class-init). The BOM below forces 1.48.0. -->
        <google-auth-library.version>1.49.0</google-auth-library.version>

        <!-- Flyway Maven plugin defaults — point at local docker-compose Postgres.
             Override per-invocation: `./mvnw flyway:info -Dflyway.url=...`.
             App-runtime migrations still run via Spring Boot's flyway-core
             auto-config (see application.yml `spring.flyway.enabled: true`);
             these properties only feed the standalone Maven plugin below. -->
        <flyway.url>jdbc:postgresql://localhost:5432/quiniela</flyway.url>
        <flyway.user>quiniela</flyway.user>
        <flyway.password>dev</flyway.password>
    </properties>

    <!-- Force newer versions of transitive deps pulled in by
         postgres-socket-factory (grpc 1.70.0 / protobuf 4.33-34 ship CVEs).
         Remove these overrides when postgres-socket-factory upgrades them
         on its own. -->
    <dependencyManagement>
        <dependencies>
            <!-- grpc-bom is imported BEFORE spring-ai-bom so it wins on grpc
                 versions (BOM precedence = declaration order). It aligns ALL
                 io.grpc artifacts to a single version, fixing the prior skew
                 where only grpc-api/grpc-context were pinned to 1.79.0 while
                 grpc-core/grpc-netty-shaded/etc. leaked in transitively at
                 1.68.0. Aligning to 1.79.0 also pulls grpc-netty-shaded past
                 CVE-2025-55163 (Netty MadeYouReset HTTP/2 DoS; fixed in
                 grpc-netty-shaded 1.75.0), which the Trivy image gate flags. -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- google-auth-library-bom imported BEFORE spring-ai-bom so it wins
                 on com.google.auth:* versions (BOM precedence = declaration
                 order). Aligns google-auth-library to 1.48.0 — the version gax
                 2.81.0 (via google-cloud-tasks 2.93.0) requires — overriding the
                 1.30.0 that google-api-client 2.9.0 pins transitively. Without it,
                 CloudTasksClient.create() throws NoClassDefFoundError for
                 com.google.auth.mtls.CertificateSourceUnavailableException. -->
            <dependency>
                <groupId>com.google.auth</groupId>
                <artifactId>google-auth-library-bom</artifactId>
                <version>${google-auth-library.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java-util</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Security 7 + OAuth2 Resource Server: validates inbound JWT
             bearer tokens that we ourselves issue after Google sign-in. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Google Identity ID token verification — for the inbound Google
             OIDC token from the Next.js Auth.js callback. -->
        <dependency>
            <groupId>com.google.api-client</groupId>
            <artifactId>google-api-client</artifactId>
            <version>${google-api-client.version}</version>
        </dependency>

        <!-- jjwt: issuing our own session JWT signed with NEXTAUTH_SECRET
             (HMAC HS256). The resource server above validates incoming
             tokens with the same key. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Cloud SQL Auth Proxy via JDBC SocketFactory. Only used when the
             `cloudrun` Spring profile is active (see application-cloudrun.yml).
             Adds ~5 MB to the jar; harmless when not activated. -->
        <dependency>
            <groupId>com.google.cloud.sql</groupId>
            <artifactId>postgres-socket-factory</artifactId>
            <version>${postgres-socket-factory.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- Spring Boot 4 modularized autoconfig: flyway-core alone is the
             library; the autoconfig that wires it into application startup
             lives in spring-boot-flyway, pulled in by this starter. Without
             the starter, FlywayAutoConfiguration is silently absent and
             migrations never run on boot. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Spring AI: Google GenAI (Gemini Developer API / AI Studio, API-key auth).
             Backs GeminiPaulOracle (the app.paul.provider=google path). -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-google-genai</artifactId>
        </dependency>

        <!-- Google's unified GenAI SDK, used directly by VertexPaulOracle for the
             Vertex AI path (ADC auth, billed to GCP credits). Pinned explicitly
             rather than relying on the transitive pull from spring-ai above, so
             the Vertex path doesn't break if Spring AI changes its SDK version. -->
        <dependency>
            <groupId>com.google.genai</groupId>
            <artifactId>google-genai</artifactId>
            <version>${google-genai.version}</version>
        </dependency>

        <!-- Cloud Tasks client — used by CloudTasksResultsQueue (prod only,
             active when app.sync.tasks.enabled=true). In local/test the
             NoopResultsTaskQueue fallback is active instead so the library
             is never called. -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-tasks</artifactId>
            <version>${google-cloud-tasks.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>quiniela-api</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Standalone Flyway CLI for local dev:
                   ./mvnw flyway:info       — see what's applied vs pending
                   ./mvnw flyway:migrate    — apply pending migrations (no app start)
                   ./mvnw flyway:validate   — check files match applied checksums
                   ./mvnw flyway:repair     — fix checksums after editing applied SQL
                   ./mvnw flyway:clean      — DROP EVERYTHING (dev only!)
                 Reads flyway.url / flyway.user / flyway.password from <properties>
                 above; override on the CLI with -Dflyway.url=... when needed.
                 Independent of Spring Boot's auto-config — both can coexist. -->
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <configuration>
                    <locations>
                        <location>filesystem:src/main/resources/db/migration</location>
                    </locations>
                    <baselineOnMigrate>true</baselineOnMigrate>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${postgresql.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-database-postgresql</artifactId>
                        <version>${flyway.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                            <style>GOOGLE</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals><goal>check</goal></goals>
                        <phase>compile</phase>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${dependency-check.version}</version>
                <configuration>
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                    <suppressionFiles>
                        <suppressionFile>.dependency-check-suppressions.xml</suppressionFile>
                    </suppressionFiles>
                    <formats>
                        <format>HTML</format>
                        <format>SARIF</format>
                    </formats>
                    <nvdValidForHours>24</nvdValidForHours>
                    <!-- Sonatype OSS Index rate-limits anonymous queries; we
                         rely on the NVD as the primary CVE data source.
                         Enable with auth if we want OSS Index back. -->
                    <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                    <!-- Stable path so GitHub Actions can cache the NVD
                         database (~1.5 GB) across runs. NVD API key is
                         passed via -DnvdApiKey from CI when the
                         NVD_API_KEY secret is set. -->
                    <dataDirectory>${user.home}/.dependency-check/data</dataDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
